# Neo4j (Graph retrieval)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Ollama / LLM endpoints & models
OLLAMA_URL=http://ollama:11434

# Prefer explicit overall model fallback (used if specific roles unset)
OLLAMA_MODEL=llama3.1:8b

# Role-specific model overrides
OLLAMA_QUERY_MODEL=qwen2.5:32b-instruct
OLLAMA_GENERATOR_MODEL=qwen2.5:32b-instruct
# Optional judge model (falls back to GENERATOR_MODEL or OLLAMA_MODEL)
OLLAMA_JUDGE_MODEL=

# Generation parameters (query / generator can differ)
OLLAMA_QUERY_NUM_PREDICT=256
OLLAMA_QUERY_TEMPERATURE=0.0

OLLAMA_GENERATOR_NUM_PREDICT=512
OLLAMA_GENERATOR_TEMPERATURE=0.0

# Project debug / behavior flags
GRAPH_RAG_DEBUG=false
GRAPH_RAG_DETERMINISTIC_MODE=false

# Organizer / pipeline tuning (existing)
ORGANIZER_THRESHOLD_K=10
ORGANIZER_FLOAT_PRECISION=
